{
    "name": "obd/logtracker",
    "description": "Premium, high-performance audit logging and activity tracking for Laravel applications.",
    "keywords": ["laravel", "audit", "activity-log", "database-tracking", "heatmap", "php"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "ronykader",
            "email": "rony.ksr06@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Obd\\Logtracker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Obd\\Logtracker\\LogtrackerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
